# One-shot seeder: compiles TypeScript and seeds MongoDB with 5e-database data
FROM node:22-slim

WORKDIR /seeder

# Install dependencies first (better layer caching)
COPY package.json package-lock.json ./
RUN npm ci

# Copy the rest of the project (source, scripts, data JSON files, etc.)
COPY . .

# Compile TypeScript
RUN npm run build:ts

# db:refresh connects to MongoDB via MONGODB_URI and imports all data.
# This container exits when seeding is complete.
CMD ["node", "scripts/built/dbRefresh.js"]
